# ERakshak environment template — copy to .env (never commit .env)

# Database — durable canonical store (review fix C1). SQLite by default; Postgres for prod.
# DATABASE_URL=postgresql+psycopg://erakshak:erakshak@localhost:5432/erakshak
DATABASE_URL=sqlite:///./data/erakshak.db

# App config
ERAKSHAK_CONFIG=config/settings.yaml
ERAKSHAK_SCORING_RULES=config/scoring_rules.yaml
LOG_LEVEL=INFO

# Security — API/dashboard auth (review fix C2). REQUIRED in production.
ERAKSHAK_JWT_SECRET=change-me-to-a-long-random-string   # >=32 bytes recommended
ERAKSHAK_TOKEN_TTL_MIN=60
ERAKSHAK_ADMIN_PASSWORD=change-me
ERAKSHAK_ANALYST_PASSWORD=change-me

# Optional / later phases
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
# ELASTICSEARCH_URL=http://localhost:9200

# Optional AI — natural-language query (F1).
# The model receives ONLY the analyst's question plus the field/operator vocabulary, and
# returns a validated query object that is executed locally. No case records, names,
# phone numbers or account numbers are ever transmitted (research/10 SR-R4); an outbound
# guard in backend/app/search/llm_planner.py enforces this and is covered by tests.
# Unset, the API silently falls back to the offline rule-based interpreter.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
