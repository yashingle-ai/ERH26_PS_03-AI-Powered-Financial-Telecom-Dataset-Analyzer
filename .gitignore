# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env & secrets
.env
*.local

# Runtime data. Reports/charts are rendered FROM case data, so they inherit its
# sensitivity — generated output never gets committed.
data/uploads/*
!data/uploads/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
data/samples/*
!data/samples/.gitkeep
data/*.db
data/*.sqlite3

# ─────────────────────────────────────────────────────────────────────────────
# REAL CASE DATA — DENY BY DEFAULT.
# datasets/ holds FIR evidence: bank statements, CDR, IPDR, CCTV, personal docs
# on real people. Everything here is ignored unless explicitly allow-listed
# below, so a new case folder is never committed just because nobody added a
# rule for it. Only the synthetic generator output is allowed through.
# ─────────────────────────────────────────────────────────────────────────────
datasets/*
!datasets/raw/
!datasets/metadata/
!datasets/entity_map.template.csv

datasets/raw/*
!datasets/raw/demo/
!datasets/raw/smoke/

datasets/metadata/*
!datasets/metadata/demo_metadata.json
!datasets/metadata/smoke_metadata.json

# Archives of case data
*.zip

!**/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Per-machine tool settings (paths differ per developer)
.claude/settings.local.json

# Node (frontend, later)
node_modules/
frontend/build/
frontend/dist/
